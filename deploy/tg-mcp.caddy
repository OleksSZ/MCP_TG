# Claude's cloud reaches everything from Anthropic's published ranges:
# https://platform.claude.com/docs/en/api/ip-addresses
# Only the sign-in page opens from anywhere, because it runs in your browser.
https://__HOST__ {
	request_body {
		max_size 5MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	@sign_in path /authorize /pair
	@anthropic remote_ip 160.79.104.0/21 153.61.208.0/20

	handle @sign_in {
		reverse_proxy unix//run/tg-mcp.sock
	}
	handle @anthropic {
		reverse_proxy unix//run/tg-mcp.sock
	}
	handle {
		respond 404
	}
}
