# The installer appends the sandbox settings from hardening.sh to the end of this file,
# and generates tg-core.service.d/sockets.conf with one socket per configured client.
[Unit]
Description=Telegram core (read-only, single session for all clients)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/tg-mcp/exports
ConditionPathExists=/var/lib/tg-mcp/private/vault.bin

[Service]
User=tgmcp
Group=tgmcp
ExecStart=/opt/tg-mcp/venv/bin/python -I -B -m tg_mcp.core
LoadCredentialEncrypted=vault-key:/etc/tg-mcp/vault-key.cred
Restart=always
RestartSec=10
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
